# Keep the build context small and keep secrets and data out of the image.

# Installed and built inside the image, never copied from the host.
node_modules
dist

# Local data and secrets. Never copy these into an image.
data
.tmp
*.db
*.db-*
*.sqlite*
.env
.env.*

# Source control and editor files.
.git
.gitignore
.vscode
.idea

# Test output and tests (the server build only compiles src/, so tests are not needed).
test-results
playwright-report
coverage
tests
vitest.config.ts

# Notes, helper scripts and host configuration that the image does not need.
*.md
docs
scripts
.railway
fly.toml
