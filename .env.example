# Tempo settings. Copy this file to ".env" for local use, or enter these as variables on your host.
# Lines starting with # are notes. Leave a value empty to use the default shown in the note.

# The public web address of your Tempo, with https and no trailing slash. Agents use it to reach Tempo.
BASE_URL=http://localhost:3000

# The port Tempo listens on. Your host (Railway) sets this for you; leave it empty there.
PORT=3000

# Where Tempo keeps its database and nightly backups. On Railway this is the volume, /data.
DATA_DIR=./data

# Set to "production" on the server. Turns on secure cookies when BASE_URL starts with https.
NODE_ENV=development

# Your Anthropic API key, which turns the Conductor on. Without it Tempo still works, in relay mode.
ANTHROPIC_API_KEY=

# Which Claude model the Conductor uses. Default: claude-sonnet-5-5.
CONDUCTOR_MODEL=claude-sonnet-5-5

# How hard the Conductor thinks: low, medium or high. Higher costs more. Default: medium.
CONDUCTOR_EFFORT=medium

# The most the Conductor may spend per calendar month, in US dollars. Then rooms switch to relay. Default: 15.
CONDUCTOR_MONTHLY_BUDGET_USD=15

# The most Conductor runs per hour per room. Default: 12.
CONDUCTOR_MAX_RUNS_PER_HOUR=12

# The model the rehearsal's stand-in agents write with when an API key is set. Default: claude-haiku-4-5.
STAND_IN_MODEL=claude-haiku-4-5

# Roughly how many tokens a briefing card may use before older items are left out. Default: 1500.
CARD_TOKEN_BUDGET=1500

# The most open instructions one agent may hold at a time from the Conductor. Default: 3.
MAX_OPEN_INSTRUCTIONS_PER_AGENT=3

# How many requests each agent key may make per minute. Default: 60.
AGENT_RATE_LIMIT_PER_MINUTE=60

# Minutes an agent has to send its report after opening a card. Default: 20.
CARD_TIMEOUT_MINUTES=20

# Seconds between scheduler ticks. Default: 30.
SCHEDULER_TICK_SECONDS=30

# Default time zone for new rooms. Default: America/Boise.
DEFAULT_TIMEZONE=America/Boise

# Optional email for alerts and daily briefs. Leave SMTP_HOST empty to turn email off.
# Your mail provider's server name, for example smtp.postmarkapp.com.
SMTP_HOST=
# Your mail server's port: 587 (most common) or 465.
SMTP_PORT=587
# The user name your mail provider gave you.
SMTP_USER=
# The password or token your mail provider gave you.
SMTP_PASS=
# Who the email appears to come from, for example Tempo <tempo@yourdomain.com>.
SMTP_FROM=
# Set to true only if your provider says to use a secure connection from the start (port 465).
SMTP_SECURE=

# Optional phone alerts through ntfy. Each person sets their own private topic in Settings.
# The ntfy server to use. Default: https://ntfy.sh.
NTFY_SERVER=https://ntfy.sh
# An ntfy access token, only if your ntfy server requires one.
NTFY_TOKEN=

# How many nightly backups to keep on the disk. Default: 7.
BACKUP_KEEP=7

# How much Tempo writes to its log: info (default), warn, error or debug.
LOG_LEVEL=info

# How many proxies sit in front of Tempo (Railway and Fly: 1). Used to see each visitor's real address for
# sign-in limits. Default: 1 in production, none otherwise. Never set it higher than the real number.
TRUST_PROXY=
